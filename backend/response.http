### Generate Bar Chart
POST {{baseUrl}}/generate_charts/{{sessionId}}/
Content-Type: application/json

{
  "chart_type": "bar",
  "x_column": "category",
  "y_column": "count",
  "title": "Category Distribution"
}


POST {{baseUrl}}/generate_charts/{{sessionId}}/
Content-Type: application/json

{
  "chart_type": "line",
  "x_column": "date",
  "y_column": "value",
  "title": "Trend Over Time"
}

### Generate Box Plot
POST {{baseUrl}}/generate_charts/{{sessionId}}/
Content-Type: application/json

{
  "chart_type": "box",
  "x_column": "group",
  "y_column": "score",
  "title": "Score Distribution by Group"
}

### Generate Histogram
POST {{baseUrl}}/generate_charts/{{sessionId}}/
Content-Type: application/json

{
  "chart_type": "histogram",
  "x_column": "age",
  "title": "Age Distribution"
}

